{
  "name": "@artemtutov/stack-editor-react",
  "version": "0.5.4",
  "description": "A Notion-style stacked block editor built on React Flow",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/stack-editor-react.css",
    "./dist/stack-editor-react.css": "./dist/stack-editor-react.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.93.2",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.3.0"
  },
  "keywords": [
    "react",
    "editor",
    "notion",
    "block-editor",
    "react-flow",
    "wysiwyg",
    "tiptap",
    "rich-text",
    "collaborative"
  ],
  "author": "Artem Tutov",
  "repository": {
    "type": "git",
    "url": "https://github.com/artemtutov/stack-editor-package.git"
  },
  "bugs": {
    "url": "https://github.com/artemtutov/stack-editor-package/issues"
  },
  "homepage": "https://github.com/artemtutov/stack-editor-package#readme",
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@tiptap/extension-highlight": "3.6.6",
    "@tiptap/extension-horizontal-rule": "3.6.6",
    "@tiptap/extension-image": "3.6.6",
    "@tiptap/extension-list": "3.6.6",
    "@tiptap/extension-placeholder": "3.6.6",
    "@tiptap/extension-subscript": "3.6.6",
    "@tiptap/extension-superscript": "3.6.6",
    "@tiptap/extension-task-item": "3.6.6",
    "@tiptap/extension-task-list": "3.6.6",
    "@tiptap/extension-text-align": "3.6.6",
    "@tiptap/extension-typography": "3.6.6",
    "@tiptap/extension-underline": "3.6.6",
    "@tiptap/extensions": "3.6.6",
    "@tiptap/html": "3.6.6",
    "@tiptap/pm": "3.6.6",
    "@tiptap/react": "3.6.6",
    "@tiptap/starter-kit": "3.6.6",
    "@tiptap/suggestion": "3.6.6",
    "dompurify": "^3.2.7",
    "lodash.throttle": "^4.1.1",
    "react-hotkeys-hook": "^5.1.0",
    "xxhash-wasm": "^1.1.0"
  }
}
